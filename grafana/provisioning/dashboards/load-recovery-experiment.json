      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(k6_http_reqs_total{run_id=~\"$run_id\", name=~\"check-in|manifest\"}[30s]))",
          "legendFormat": "{{name}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_iterations_total{run_id=~\"$run_id\"}[30s]))",
          "legendFormat": "iterations"
        }
      ]
    },
