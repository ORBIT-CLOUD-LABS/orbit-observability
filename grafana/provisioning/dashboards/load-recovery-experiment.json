      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name) (k6_http_req_duration_p95{run_id=~\"$run_id\", name=~\"check-in|manifest\"})",
          "legendFormat": "{{name}} p95"
        }
      ]
    },
