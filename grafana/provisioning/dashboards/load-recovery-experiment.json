          "legendFormat": "user"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=~\"system|irq|softirq\", instance=\"192.168.100.106:9100\"}[5m])) / count(node_cpu_seconds_total{mode=\"idle\", instance=\"192.168.100.106:9100\"})",
          "legendFormat": "system"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(node_cpu_seconds_total{mode=\"iowait\", instance=\"192.168.100.106:9100\"}[5m])) / count(node_cpu_seconds_total{mode=\"idle\", instance=\"192.168.100.106:9100\"})",
          "legendFormat": "iowait"
        },
        {
          "refId": "D",
